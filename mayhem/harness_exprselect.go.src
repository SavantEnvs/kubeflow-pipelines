// mayhem/harness_exprselect.go.src — OSS-Fuzz's FuzzExprSelect harness for Kubeflow Pipelines'
// CEL expression selector (backend/src/v2/expression: New + (*Expr).Select), ported from
// google/oss-fuzz projects/kubeflow-pipelines/expr_fuzzer.go (SPEC §6.2 item 12: every
// OSS-Fuzz harness is shipped). The fuzz body is OSS-Fuzz's, unchanged. The file also holds
// test.sh's probe entry point FuzzKATExprSelect (not OSS-Fuzz's; see its comment).
//
// OSS-Fuzz drops the harness INTO backend/src/v2/expression after deleting upstream's
// expression_test.go. We never touch upstream files: mayhem/build.sh stages this file (with the
// test.sh KAT probe, kat_exprselect.go, in the same package) as _mayhem_harness/exprselect/
// inside the repo's own module and reaches the package through its public API (New, Select),
// so the graded build compiles the in-tree
// (agent-editable) expression package and its real dependency graph. The go-118-fuzz-build
// shim decodes the arguments from the input bytes (go-fuzz-headers: each string is a 4-byte
// big-endian length + bytes, the uint8 one byte); the committed seeds use that encoding.
package exprselect

import (
	"testing"

	"github.com/kubeflow/pipelines/backend/src/v2/expression"
	"google.golang.org/protobuf/types/known/structpb"
)

func FuzzExprSelect(f *testing.F) {
	f.Fuzz(func(t *testing.T, input1, input2, input3, input4 string, inputType uint8) {
		var input *structpb.Value
		switch int(inputType) % 2 {
		case 0:
			input = structpb.NewStringValue(input1)
		case 1:
			m := map[string]interface{}{
				input2: input3,
			}
			s, err := structpb.NewStruct(m)
			if err != nil {
				return
			}
			input = structpb.NewStructValue(s)

		}

		expr, err := expression.New()
		if err != nil {
			t.Fatal(err)
		}
		expr.Select(input, input4)
	})
}

// FuzzKATExprSelect is NOT part of the OSS-Fuzz harness: it is mayhem/test.sh's
// known-answer probe entry point, built with -func FuzzKATExprSelect into
// /mayhem/kfp_exprselect_kat. It is never a Mayhem target and is dead code in
// /mayhem/FuzzExprSelect.
// It lives in THIS file, next to FuzzExprSelect, on purpose: go-118-fuzz-build
// rewrites (and moves aside for the duration of the build) only the ONE file that
// holds the -func function, compiling every other file of the package as it is on
// disk. With both entry points in one file, the package built for the graded
// target and the package built for the probe have the same files with the same
// contents, so they are the same compile (the second build is a Go build-cache
// hit); only go-118-fuzz-build's generated main differs. The probe's logic, which
// only prints computed values, is katSelectRun in kat_exprselect.go.
func FuzzKATExprSelect(f *testing.F) {
	f.Fuzz(func(t *testing.T, cases string) { katSelectRun(cases) })
}
